{
  "name": "meme-svg-generator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "gen": "npx generate-react-cli c",
    "gen:layout": "npx generate-react-cli c --type=layout",
    "json": "json-server -p 5629 db.json"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "bootstrap": "^5.3.8",
    "orsys-tjs-meme": "^1.0.3",
    "react": "^19.2.8",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.2.8",
    "react-redux": "^9.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "json-server": "0.17.4",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
